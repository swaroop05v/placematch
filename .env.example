# Copy this file to .env and fill in real values. .env is git-ignored.

# Neon (or any PostgreSQL 15+ with pgvector) connection string.
# Neon dashboard -> your project -> Connect -> copy the "pooled" connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Secret used to sign login session tokens (any long random string).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: offline fallback. `npm run db:local` starts an embedded Postgres (PGlite + pgvector)
# on this URL so the app can run without Neon:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
